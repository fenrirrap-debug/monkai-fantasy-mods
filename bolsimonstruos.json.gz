f8;\n  --tarjeta: #f8f8f8; --tarjeta-2: #c8e0f8; --hondo: #e8f4f8; --barra: #f8f8f8; --panel: #f8f8f8; --nav: #f8f8f8; --boton-gris: #4870a8;\n  --tiza: #182030; --tiza-suave: #485880; --borde: #283870; --linea: rgba(40, 56, 112, 0.35);\n  --oro: #a87000; --principal: #e04028; --principal-oscuro: #902010; --rojo: #e04028; --bien: #188838; --mal: #c02818;\n  --azul-pts: #3070d0; --verde-pts: #20a040; --naranja-pts: #e08010; --rojo-pts: #d03020;\n  --pixel: \"RETRO\", monospace; --dorsal: \"RETRO\", monospace; --texto: \"RETRO\", monospace;\n  --campo-a: #4870a8; --campo-b: #40669c; --campo-raya: rgba(248, 248, 248, 0.55); --campo-borde: #283870; --campo-texto: rgba(248, 248, 248, 0.8);\n  color-scheme: light;\n}\n:root[data-tema-propio='nostalgia'] body { background: var(--fondo); background-image: none; line-height: 1.7; overflow-wrap: break-word; -webkit-font-smoothing: none; }\n:root[data-tema-propio='nostalgia'] * { letter-spacing: 0 !important; text-shadow: none !important; }\n:root[data-tema-propio='nostalgia'] input, :root[data-tema-propio='nostalgia'] select, :root[data-tema-propio='nostalgia'] textarea { background: #fff; color: var(--tiza); font-family: \"RETRO\", monospace; }\n:root[data-tema-propio='nostalgia'] :is(.boton, .boton-ancho, .boton-pujar, .panel, .tarjeta-mercado, .hoja, .segmentos, .segmentos button, .buscador, .chip-linea, .pildora-error,\n  .estadisticas, .partido, .instalacion, .aviso, .aviso-dev, .mercado-negro, .aviso-negro, .opcion-tema, .campo-texto, .dinero, .jornada-tag, .tostada, .chip-estado,\n  .icono-inst, .pips span, .lista-jornada .total, .redondo, .puntos-badge, .otra-pos, .por-dos, .campo, .placa, .caja-partido, .partido-caja, .fila-manager, .tarjeta-inicio) { border-radius: 0 !important; }\n:root[data-tema-propio='nostalgia'] :is(.panel, .tarjeta-mercado, .opcion-tema, .instalacion, .estadisticas, .aviso, .tostada) { background: #f8f8f8; border: 3px double var(--borde); box-shadow: 2px 2px 0 rgba(24, 32, 48, 0.25); }\n:root[data-tema-propio='nostalgia'] .hoja { border: 3px double var(--borde); border-bottom: 0; max-width: 100vw; overflow-x: hidden; }\n:root[data-tema-propio='nostalgia'] .cabecera { background: #f8f8f8; border-bottom: 3px double var(--borde); }\n:root[data-tema-propio='nostalgia'] .pestanas { background: #f8f8f8; border-bottom: 3px double var(--borde); }\n:root[data-tema-propio='nostalgia'] .pestanas button { }\n:root[data-tema-propio='nostalgia'] :is(.pestanas button[aria-current=\"page\"], .tabs-ficha button[aria-selected=\"true\"]) { color: var(--tiza); }\n:root[data-tema-propio='nostalgia'] .segmentos { background: #e0ecf8; border: 2px solid var(--borde); }\n:root[data-tema-propio='nostalgia'] .segmentos button[aria-selected=\"true\"] { background: var(--borde); color: #f8f8f8; }\n:root[data-tema-propio='nostalgia'] .boton { border-bottom-width: 3px; box-shadow: 2px 2px 0 rgba(24, 32, 48, 0.4); max-width: 100%; white-space: normal; }\n:root[data-tema-propio='nostalgia'] .boton.sobrio { background: #f8f8f8; border: 2px solid var(--borde); color: var(--tiza); }\n:root[data-tema-propio='nostalgia'] .boton-ancho { color: #f8f8f8; }\n:root[data-tema-propio='nostalgia'] .redondo { background: #f8f8f8; border: 2px solid var(--borde); color: var(--tiza); }\n:root[data-tema-propio='nostalgia'] .cabecera .marca { }\n:root[data-tema-propio='nostalgia'] .cabecera .dinero { background: #f8f0c8; border: 2px solid var(--oro); }\n:root[data-tema-propio='nostalgia'] :is(h1, h2, h3, .subtitulo) { line-height: 1.5; }\n:root[data-tema-propio='nostalgia'] .hoja-cabecera h2 { }\n:root[data-tema-propio='nostalgia'] .barra-inferior, :root[data-tema-propio='nostalgia'] .barra-datos { background: #f8f8f8; border-top: 3px double var(--borde); }\n:root[data-tema-propio='nostalgia'] .velo { background: rgba(24, 32, 48, 0.45); }\n:root[data-tema-propio='nostalgia'] .marcador-combate { background: #283870; color: #f8f8f8; }\n:root[data-tema-propio='nostalgia'] img.pixel, :root[data-tema-propio='nostalgia'] .icono-pixel { image-rendering: pixelated; }\n:root[data-tema-propio='nostalgia'] .barra-datos span { overflow: hidden; text-overflow: ellipsis; max-width: 100%; }\n:root[data-tema-propio='nostalgia'] .barra-datos strong { }\n:root[data-tema-propio='nostalgia'] .marcador-combate :is(small, strong) { color: #f8f8f8; }\n:root[data-tema-propio='nostalgia'] .marcador-combate .gana strong { color: #f8d030; }\n:root[data-tema-propio='nostalgia'] .campo :is(.extra-hueco, .rol-mini) { color: #f8f8f8; }\n:root[data-tema-propio='nostalgia'] .aviso-dev { background: #f8f0c8; border-color: var(--oro); color: #604000; }\n:root[data-tema-propio='nostalgia'] .tabs-ficha { background: #f8f8f8; }\n:root[data-tema-propio='nostalgia'] .kos b { background: var(--borde); }\n:root[data-tema-propio='nostalgia'] .mercado-evento { border: 3px double var(--ev-acento); border-radius: 0 !important; box-shadow: 2px 2px 0 rgba(24, 32, 48, 0.25); }\n:root[data-tema-propio='nostalgia'] :is(.logo-evento, .chips-dev li, .sugerencias) { border-radius: 0 !important; }\n:root[data-tema-propio='nostalgia'] :is(.mision, .trofeo, .chip-mision, .cabeza-misiones b, .mision .icono-mision, .trofeo .medalla, .tarjeta-misiones) { border-radius: 0 !important; }\n:root[data-tema-propio='nostalgia'] :is(.mision, .trofeo) { background: #f8f8f8; border: 3px double var(--borde); }\n:root[data-tema-propio='nostalgia'] .tostada.mision, :root[data-tema-propio='nostalgia'] .tostada.trofeo { background: #f8f8f8; color: var(--tiza); }\n:root[data-tema-propio='nostalgia'] :is(.carta-memory .cara, .marcador-memory span, .fin-memory) { border-radius: 0 !important; }\n:root[data-tema-propio='nostalgia'] :is(.marcador-memory span, .fin-memory, .carta-memory .frente) { background: #f8f8f8; border: 3px double var(--borde); }\n:root[data-tema-propio='nostalgia'] :is(.boton-pujar, .boton-accion) { padding-inline: 2px; }\n:root[data-tema-propio='nostalgia'] .boton-pujar small { }\n:root[data-tema-propio='nostalgia'] :is(.casilla-wordle, .tecla) { border-radius: 0 !important; }\n:root[data-tema-propio='nostalgia'] small { overflow-wrap: normal; }"},"fuego":{"propio":true,"base":"original","nombre":"Campo de fuego","texto":"Brasas y tonos volcánicos, con letra pixelada clásica.","colores":["#2a0d08","#5a2414","#f06030","#f8c048"],"barra":"#1a0704","estado":"oculto","pixel":true,"css":".opcion-tema.tema-fuego .quien strong { font-family: \"Pixel FRLG\", var(--dorsal); font-size: 1.2rem; }\n:root[data-tema-propio='fuego'] {\n  --fondo: #2a0d08; --cesped: #2a0d08; --cesped-2: #3a140c; --cesped-3: #4d1c10;\n  --tarjeta: #451a10; --tarjeta-2: #5a2414; --hondo: #1a0704; --barra: #3a120a; --panel: #33100a; --nav: #40160c; --boton-gris: #5a2a1c;\n  --tiza: #fff3e6; --tiza-suave: #e2bba3; --borde: rgba(255, 220, 190, 0.16); --linea: rgba(255, 220, 190, 0.18);\n  --oro: #f8c048; --principal: #e8481c; --principal-oscuro: #a02a0c; --rojo: #f06030;\n  --pixel: \"Pixel FRLG\", \"Barlow Condensed\", sans-serif;\n  --campo-a: #8a3216; --campo-b: #7c2c12; --campo-raya: rgba(255, 230, 200, 0.32); --campo-borde: rgba(255, 220, 190, 0.35);\n}\n:root[data-tema-propio='fuego'] body { background-image: repeating-linear-gradient(90deg, transparent 0 64px, rgba(255, 160, 80, 0.03) 64px 128px); }\n:root[data-tema-propio='fuego'] .cabecera .dinero { background: rgba(0, 0, 0, 0.2); }"},"hojas":{"propio":true,"base":"original","nombre":"Campo de hojas","texto":"Verdes de bosque y hierba alta, con letra pixelada clásica.","colores":["#10280c","#2c521c","#58b030","#d8e870"],"barra":"#0a1a06","estado":"oculto","pixel":true,"css":".opcion-tema.tema-hojas .quien strong { font-family: \"Pixel FRLG\", var(--dorsal); font-size: 1.2rem; }\n:root[data-tema-propio='hojas'] {\n  --fondo: #12290c; --cesped: #12290c; --cesped-2: #1b3812; --cesped-3: #26491a;\n  --tarjeta: #213f16; --tarjeta-2: #2c521c; --hondo: #0a1a06; --barra: #1b3812; --panel: #183410; --nav: #1e3c14; --boton-gris: #34502a;\n  --tiza: #f2f8e0; --tiza-suave: #bcd49c; --borde: rgba(230, 250, 190, 0.16); --linea: rgba(230, 250, 190, 0.18);\n  --oro: #e0e870; --principal: #48a02a; --principal-oscuro: #2c6e14; --rojo: #78c840; --bien: #a8e070;\n  --pixel: \"Pixel FRLG\", \"Barlow Condensed\", sans-serif;\n  --campo-a: #3c7a1e; --campo-b: #356e1a; --campo-raya: rgba(240, 255, 210, 0.32); --campo-borde: rgba(230, 250, 190, 0.35);\n}\n:root[data-tema-propio='hojas'] body { background-image: repeating-linear-gradient(90deg, transparent 0 64px, rgba(200, 255, 120, 0.03) 64px 128px); }\n:root[data-tema-propio='hojas'] .cabecera .dinero { background: rgba(0, 0, 0, 0.2); }"},"zafiro":{"propio":true,"base":"original","nombre":"Campo de mareas","texto":"Azules de mar abierto y espuma, con letra pixelada clásica.","colores":["#0c1d3e","#1c4c8c","#3890f0","#f8d048"],"barra":"#081530","estado":"oculto","css":":root[data-tema-propio='zafiro'] {\n  --fondo: #0c1d3e; --cesped: #0c1d3e; --cesped-2: #142a54; --cesped-3: #1c3a6c;\n  --tarjeta: #15315f; --tarjeta-2: #1c4c8c; --hondo: #081530; --barra: #102650; --panel: #102a56; --nav: #132e5c; --boton-gris: #2a4a80;\n  --tiza: #eef5ff; --tiza-suave: #a8c0e0; --borde: rgba(200, 225, 255, 0.16); --linea: rgba(200, 225, 255, 0.18);\n  --oro: #f8d048; --principal: #3890f0; --principal-oscuro: #1c60c0; --rojo: #3890f0; --bien: #78d8a8;\n  --pixel: \"Pixel FRLG\", \"Barlow Condensed\", sans-serif;\n  --campo-a: #1f5aa0; --campo-b: #1b5194; --campo-raya: rgba(220, 240, 255, 0.34); --campo-borde: rgba(200, 225, 255, 0.4);\n}\n:root[data-tema-propio='zafiro'] body { background-image: repeating-linear-gradient(180deg, transparent 0 48px, rgba(120, 180, 255, 0.035) 48px 96px); }\n.opcion-tema:is(.tema-zafiro) .quien strong { font-family: \"Pixel FRLG\", var(--dorsal); font-size: 1.2rem; }"},"platino":{"propio":true,"base":"original","nombre":"Campo de distorsión","texto":"Gris acero y oro, con un aire de otra dimensión.","colores":["#1c1d24","#4a4d5a","#c8a040","#d04048"],"barra":"#121318","estado":"oculto","css":":root[data-tema-propio='platino'] {\n  --fondo: #1c1d24; --cesped: #1c1d24; --cesped-2: #262832; --cesped-3: #30333f;\n  --tarjeta: #2b2d37; --tarjeta-2: #3a3e4a; --hondo: #121318; --barra: #22242c; --panel: #24262f; --nav: #282a33; --boton-gris: #4a4d5a;\n  --tiza: #f0f0f4; --tiza-suave: #b4b6c4; --borde: rgba(220, 222, 235, 0.16); --linea: rgba(220, 222, 235, 0.18);\n  --oro: #d8b048; --principal: #c03038; --principal-oscuro: #8a1c24; --rojo: #d04048; --bien: #8cd0a0;\n  --pixel: \"Pixel DP\", \"Barlow Condensed\", sans-serif;\n  --campo-a: #555a68; --campo-b: #4d5260; --campo-raya: rgba(230, 232, 245, 0.32); --campo-borde: rgba(216, 176, 72, 0.5);\n}\n:root[data-tema-propio='platino'] body { background-image: repeating-linear-gradient(135deg, transparent 0 40px, rgba(216, 176, 72, 0.025) 40px 80px); }\n.opcion-tema:is(.tema-platino, .tema-blanco, .tema-negro) .quien strong { font-family: \"Pixel DP\", var(--dorsal); font-size: 1.15rem; }"},"blanco":{"propio":true,"base":"original","nombre":"Campo de luz","texto":"Blanco limpio y luminoso, con letra pixelada.","colores":["#eef0f2","#ffffff","#2b8ad8","#f08a28"],"barra":"#d8dce0","estado":"oculto","desbloqueo":{"tipo":"codigo","codigo":"RESHIRAM"},"claro":true,"css":":root[data-tema-propio='blanco'] {\n  --fondo: #eef0f2; --cesped: #eef0f2; --cesped-2: #ffffff; --cesped-3: #f4f6f8;\n  --tarjeta: #ffffff; --tarjeta-2: #e6ebf0; --hondo: #e2e6ea; --barra: #ffffff; --panel: #f7f8fa; --nav: #ffffff; --boton-gris: #5f6b78;\n  --tiza: #1d2228; --tiza-suave: #5b6672; --borde: rgba(30, 40, 55, 0.14); --linea: rgba(30, 40, 55, 0.14);\n  --oro: #b8780c; --principal: #2b8ad8; --principal-oscuro: #1a68ac; --rojo: #f08a28; --bien: #1f9a54; --mal: #d0402a;\n  --pixel: \"Pixel DP\", \"Barlow Condensed\", sans-serif;\n  --campo-a: #d9dfe6; --campo-b: #cfd6de; --campo-raya: rgba(255, 255, 255, 0.95); --campo-borde: #9aa6b4; --campo-texto: rgba(40, 52, 66, 0.6);\n  color-scheme: light;\n}\n:root[data-tema-propio='blanco'] .cabecera { background: #ffffff; border-bottom: 1px solid var(--borde); }\n:root:is([data-tema-propio='blanco'], [data-tema-propio='alola']) .campo :is(.extra-hueco, .rol-mini) { color: #2a2018; text-shadow: none; }\n:root:is([data-tema-propio='blanco'], [data-tema-propio='alola']) .campo .valla { box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2); }\n.opcion-tema:is(.tema-platino, .tema-blanco, .tema-negro) .quien strong { font-family: \"Pixel DP\", var(--dorsal); font-size: 1.15rem; }"},"negro":{"propio":true,"base":"original","nombre":"Campo de sombras","texto":"Negro profundo con destellos eléctricos azules.","colores":["#0e0f12","#24272e","#30b0f0","#e84838"],"barra":"#08090b","estado":"oculto","desbloqueo":{"tipo":"codigo","codigo":"ZEKROM"},"css":":root[data-tema-propio='negro'] {\n  --fondo: #0e0f12; --cesped: #0e0f12; --cesped-2: #17191d; --cesped-3: #202329;\n  --tarjeta: #1b1d22; --tarjeta-2: #24272e; --hondo: #08090b; --barra: #121317; --panel: #15171b; --nav: #181a1f; --boton-gris: #33363f;\n  --tiza: #f2f4f7; --tiza-suave: #a3a9b4; --borde: rgba(220, 230, 245, 0.13); --linea: rgba(220, 230, 245, 0.16);\n  --oro: #f0c040; --principal: #30a8e8; --principal-oscuro: #1878b0; --rojo: #30b0f0; --bien: #6ad6a0;\n  --pixel: \"Pixel DP\", \"Barlow Condensed\", sans-serif;\n  --campo-a: #2b2e36; --campo-b: #262930; --campo-raya: rgba(48, 176, 240, 0.4); --campo-borde: rgba(48, 176, 240, 0.45);\n}\n.opcion-tema:is(.tema-platino, .tema-blanco, .tema-negro) .quien strong { font-family: \"Pixel DP\", var(--dorsal); font-size: 1.15rem; }"},"prisma":{"propio":true,"base":"original","nombre":"Campo de prisma","texto":"Azul de Kalos y rojo intenso, con destellos de cristal.","colores":["#0d1630","#22356e","#e8364a","#3f8cff"],"barra":"#08102a","estado":"oculto","css":":root[data-tema-propio='prisma'] {\n  --fondo: #0d1630; --cesped: #0d1630; --cesped-2: #142147; --cesped-3: #1b2b58;\n  --tarjeta: #15204a; --tarjeta-2: #1f2d61; --hondo: #08102a; --barra: #101a3c; --panel: #131d44; --nav: #121c42; --boton-gris: #34407a;\n  --tiza: #f3f5ff; --tiza-suave: #aab4dc; --borde: rgba(200, 215, 255, 0.15); --linea: rgba(200, 215, 255, 0.17);\n  --oro: #f2c94c; --principal: #e8364a; --principal-oscuro: #a81f30; --rojo: #3f8cff; --bien: #6ad6a0;\n  --pixel: \"Pixel DP\", \"Barlow Condensed\", sans-serif;\n  --campo-a: #22356e; --campo-b: #1e3065; --campo-raya: rgba(140, 190, 255, 0.5); --campo-borde: rgba(232, 54, 74, 0.6);\n}\n:root[data-tema-propio='prisma'] body { background-image: linear-gradient(135deg, rgba(63, 140, 255, 0.1) 0 50%, rgba(232, 54, 74, 0.1) 50% 100%); background-attachment: fixed; }"},"alola":{"propio":true,"base":"original","nombre":"Campo de arena","texto":"Noche violeta, sol naranja y un campo de arena de playa.","colores":["#251a36","#d8b678","#f39a2b","#8a6ad8"],"barra":"#1a1226","estado":"oculto","css":":root[data-tema-propio='alola'] {\n  --fondo: #251a36; --cesped: #251a36; --cesped-2: #2f2244; --cesped-3: #3a2b52;\n  --tarjeta: #33264a; --tarjeta-2: #43325f; --hondo: #1a1226; --barra: #2a1e3c; --panel: #2c2040; --nav: #302345; --boton-gris: #54426e;\n  --tiza: #fbf3ea; --tiza-suave: #c9b8d8; --borde: rgba(240, 225, 255, 0.15); --linea: rgba(240, 225, 255, 0.17);\n  --oro: #f8c050; --principal: #f39a2b; --principal-oscuro: #c26a10; --rojo: #f39a2b; --bien: #7ad8b0;\n  --pixel: \"Nunito\", \"Barlow\", sans-serif; --dorsal: \"Nunito\", \"Barlow\", sans-serif; --texto: \"Nunito\", \"Barlow\", sans-serif;\n  --campo-a: #dcbb7e; --campo-b: #d2b073; --campo-raya: rgba(255, 252, 240, 0.85); --campo-borde: #b8925a; --campo-texto: rgba(92, 62, 22, 0.7);\n}\n:root[data-tema-propio='alola'] body { background-image: radial-gradient(circle at 85% -10%, rgba(243, 154, 43, 0.18), transparent 45%), radial-gradient(circle at 10% 110%, rgba(138, 106, 216, 0.2), transparent 50%); background-attachment: fixed; }\n:root[data-tema-propio='alola'] .pestanas button { }\n:root[data-tema-propio='alola'] :is(.fila-ejemplar .quien strong, .suplente .quien strong) { }\n:root[data-tema-propio='alola'] .marca { }\n:root:is([data-tema-propio='blanco'], [data-tema-propio='alola']) .campo :is(.extra-hueco, .rol-mini) { color: #2a2018; text-shadow: none; }\n:root:is([data-tema-propio='blanco'], [data-tema-propio='alola']) .campo .valla { box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2); }\n.opcion-tema.tema-alola .quien strong { font-family: \"Nunito\", sans-serif; font-weight: 800; font-size: 1.05rem; }"},"acero":{"propio":true,"base":"original","nombre":"Campo de acero","texto":"Noche de partido: acero, cian y fucsia, con letra de marcador.","colores":["#14161b","#3a4452","#22c3e6","#e8307e"],"barra":"#0c0e12","estado":"oculto","css":":root[data-tema-propio='acero'] {\n  --fondo: #14161b; --cesped: #14161b; --cesped-2: #1c1f26; --cesped-3: #252932;\n  --tarjeta: #1e2128; --tarjeta-2: #2a2e37; --hondo: #0c0e12; --barra: #181b21; --panel: #1a1d23; --nav: #1c1f26; --boton-gris: #3a404c;\n  --tiza: #f2f4f7; --tiza-suave: #a6adba; --borde: rgba(210, 225, 240, 0.14); --linea: rgba(210, 225, 240, 0.16);\n  --oro: #f2c230; --principal: #e8307e; --principal-oscuro: #a81c58; --rojo: #22c3e6; --bien: #5fe0b0;\n  --pixel: \"Oswald\", \"Barlow Condensed\", sans-serif; --dorsal: \"Oswald\", \"Barlow Condensed\", sans-serif;\n  --campo-a: #3a4452; --campo-b: #343d4a; --campo-raya: rgba(34, 195, 230, 0.55); --campo-borde: #e8307e;\n}\n:root[data-tema-propio='acero'] body { background-image: linear-gradient(115deg, rgba(34, 195, 230, 0.06) 0 50%, rgba(232, 48, 126, 0.06) 50% 100%); background-attachment: fixed; }\n:root[data-tema-propio='acero'] :is(.fila-ejemplar .quien strong, .info-venta h3, .hueco .placa) { letter-spacing: 0.01em; }\n:root[data-tema-propio='acero'] .marca { letter-spacing: 0.04em; text-transform: uppercase; }\n.opcion-tema.tema-acero .quien strong { font-family: \"Oswald\", sans-serif; font-weight: 600; text-transform: uppercase; }\n:root[data-tema-propio='acero'] { --campo-a: #3f8f2e; --campo-b: #388228; --campo-raya: rgba(255, 255, 255, 0.85); --campo-borde: #e8307e; --campo-texto: rgba(255, 255, 255, 0.7); }\n:root[data-tema-propio='acero'] .campo {\n  border: 4px solid transparent; border-image: linear-gradient(90deg, #e8307e, #22c3e6, #e8307e) 1;\n  box-shadow: 0 0 0 3px #101218, 0 0 18px rgba(232, 48, 126, 0.4), 0 0 28px rgba(34, 195, 230, 0.3);\n}"},"antano":{"propio":true,"base":"original","nombre":"Campo de antaño","texto":"Pergamino, tinta y praderas de otra época.","colores":["#e6d9bc","#f4ecd8","#3b2e22","#b23a2a"],"barra":"#cbbb98","estado":"oculto","desbloqueo":{"tipo":"codigo","codigo":"HISUI"},"claro":true,"css":":root[data-tema-propio='antano'] {\n  --fondo: #e6d9bc; --cesped: #e6d9bc; --cesped-2: #f4ecd8; --cesped-3: #efe4cc;\n  --tarjeta: #f4ecd8; --tarjeta-2: #e3d5b4; --hondo: #d8c8a4; --barra: #f1e7cf; --panel: #f2e9d3; --nav: #f1e7cf; --boton-gris: #6a5640;\n  --tiza: #2f251b; --tiza-suave: #6b5a48; --borde: rgba(59, 46, 34, 0.22); --linea: rgba(59, 46, 34, 0.2);\n  --oro: #8a6a1c; --principal: #b23a2a; --principal-oscuro: #7e2418; --rojo: #b23a2a; --bien: #3f7a3a; --mal: #a8321e;\n  --pixel: \"Alegreya Sans SC\", \"Barlow\", serif; --dorsal: \"Alegreya Sans SC\", \"Barlow Condensed\", serif;\n  --campo-a: #8aa070; --campo-b: #819767; --campo-raya: rgba(250, 244, 226, 0.75); --campo-borde: #6b5a48; --campo-texto: rgba(40, 30, 20, 0.55);\n  color-scheme: light;\n}\n:root[data-tema-propio='antano'] body { background-image: radial-gradient(circle at 20% 10%, rgba(255, 255, 255, 0.35), transparent 40%), radial-gradient(circle at 80% 90%, rgba(120, 90, 50, 0.12), transparent 45%); background-attachment: fixed; }\n:root[data-tema-propio='antano'] .cabecera { background: #efe4cc; border-bottom: 1px solid var(--borde); }\n:root[data-tema-propio='antano'] :is(.fila-ejemplar .quien strong, .info-venta h3) { }\n:root[data-tema-propio='antano'] .campo :is(.extra-hueco, .rol-mini) { color: #2a2018; text-shadow: none; }\n.opcion-tema.tema-antano .quien strong { font-family: \"Alegreya Sans SC\", serif; font-weight: 700; }"},"paradoja":{"propio":true,"base":"original","nombre":"Campo de paradoja","texto":"Violeta y naranja, entre lo antiguo y lo futuro.","colores":["#1b1030","#3c2c66","#ff7a1a","#a066ff"],"barra":"#120a22","estado":"oculto","css":":root[data-tema-propio='paradoja'] {\n  --fondo: #1b1030; --cesped: #1b1030; --cesped-2: #24173f; --cesped-3: #2e1f4f;\n  --tarjeta: #261a42; --tarjeta-2: #33245a; --hondo: #120a22; --barra: #1f1438; --panel: #22173c; --nav: #241940; --boton-gris: #4a3a78;\n  --tiza: #f6f0ff; --tiza-suave: #bfaedd; --borde: rgba(220, 200, 255, 0.15); --linea: rgba(220, 200, 255, 0.17);\n  --oro: #ffb547; --principal: #ff7a1a; --principal-oscuro: #c2560a; --rojo: #ff7a1a; --bien: #7ee0b6;\n  --pixel: \"Exo 2\", \"Barlow\", sans-serif; --dorsal: \"Exo 2\", \"Barlow Condensed\", sans-serif;\n  --campo-a: #3c2c66; --campo-b: #36285c; --campo-raya: rgba(255, 122, 26, 0.6); --campo-borde: #a066ff;\n}\n:root[data-tema-propio='paradoja'] body { background-image: radial-gradient(circle at 0% 0%, rgba(255, 122, 26, 0.14), transparent 40%), radial-gradient(circle at 100% 100%, rgba(160, 102, 255, 0.18), transparent 45%); background-attachment: fixed; }\n:root[data-tema-propio='paradoja'] .pestanas button { }\n:root[data-tema-propio='paradoja'] :is(.fila-ejemplar .quien strong, .info-venta h3, .hueco .placa) { }\n.opcion-tema.tema-paradoja .quien strong { font-family: \"Exo 2\", sans-serif; font-weight: 700; }"},"neon":{"propio":true,"base":"original","nombre":"Campo de neón","texto":"Ciudad de noche: asfalto, neón y lima eléctrica.","colores":["#0a0d12","#1d242d","#c6f03a","#ff3fae"],"barra":"#06080b","estado":"oculto","css":":root[data-tema-propio='neon'] {\n  --fondo: #0a0d12; --cesped: #0a0d12; --cesped-2: #11161d; --cesped-3: #182029;\n  --tarjeta: #121820; --tarjeta-2: #1b232d; --hondo: #06080b; --barra: #0e1218; --panel: #10151c; --nav: #11161d; --boton-gris: #2a3440;\n  --tiza: #eef6e4; --tiza-suave: #9fb0a0; --borde